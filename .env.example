# ==============================================================================
# AutoMind AI — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to '.env' for local development:
#      cp .env.example .env
# 2. For production deployments, DO NOT commit the filled '.env' file.
# 3. Generate strong cryptographically secure 256-bit secrets using:
#      openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME="AutoMind AI"

# Environment: "development" | "staging" | "production"
# In production, DEBUG must be False and secrets must be explicitly set.
APP_ENV="development"
DEBUG=False

# Application Secret Key (Used for internal cryptographic signing and session cookies)
# Generate with: openssl rand -hex 32
APP_SECRET="<GENERATE_RANDOM_SECRET_WITH_OPENSSL_RAND_HEX_32>"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# MySQL 8.0 connection string format:
#   mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
#
# Examples:
#   Local Docker Dev:  mysql+pymysql://automind_user:change_dev_password@localhost:3307/automind_db
#   Internal Compose:  mysql+pymysql://automind_user:change_dev_password@mysql:3306/automind_db
#   Production:        mysql+pymysql://<PROD_USER>:<PROD_PASS>@<PROD_HOST>:3306/<PROD_DB>
DATABASE_URL="mysql+pymysql://automind_user:change_dev_password@localhost:3307/automind_db"

# MySQL container environment variables (used by Docker Compose)
MYSQL_ROOT_PASSWORD="<GENERATE_STRONG_ROOT_PASSWORD>"
MYSQL_DATABASE="automind_db"
MYSQL_USER="automind_user"
MYSQL_PASSWORD="<GENERATE_STRONG_USER_PASSWORD>"

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# JWT Signing Secret (Separate from APP_SECRET)
# Generate with: openssl rand -hex 32
JWT_SECRET="<GENERATE_RANDOM_SECRET_WITH_OPENSSL_RAND_HEX_32>"
JWT_ALGORITHM="HS256"

# Token validity window in minutes (Default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, MUST NOT contain wildcards ('*') or localhost.
#
# Examples:
#   Local Development: "http://localhost:5173,http://127.0.0.1:5173"
#   Production:        "https://automind.ai,https://app.automind.ai"
FRONTEND_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 5. Local Development Demo Seeding (STRICTLY LOCAL DEV ONLY)
# ------------------------------------------------------------------------------
# Demo user creation is disabled by default. To opt-in during local development:
# 1. APP_ENV must equal "development"
# 2. SEED_DEMO_DATA must equal "true"
SEED_DEMO_DATA=false
DEV_DEMO_PASSWORD="<LOCAL_DEV_PASSWORD_ONLY>"

# ------------------------------------------------------------------------------
# 6. AI, LLM & RAG Engine Settings
# ------------------------------------------------------------------------------
LLM_PROVIDER="local"
LLM_MODEL_ID="qwen_lora_v4"
EMBEDDING_MODEL_ID="all-MiniLM-L6-v2"

VECTOR_STORE_TYPE="local"
VECTOR_INDEX_PATH="./vector_index"

RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
MAX_CONTEXT_DOCUMENTS=8
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Live Web Grounding via DuckDuckGo
ENABLE_DUCKDUCKGO_SEARCH=true
DUCKDUCKGO_MAX_RESULTS=5
