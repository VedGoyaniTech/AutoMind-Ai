# ==============================================================================
# AutoMind AI / Project-V — Environment Configuration Template
# Generate strong 256-bit secrets for production using:
#   openssl rand -hex 32
# ==============================================================================

# Application Environment
APP_NAME="AutoMind AI"
APP_ENV="development" # Set to "production" in live deployment
APP_SECRET="your-strong-app-secret-here-use-openssl-rand-hex-32"
DEBUG=True

# Database Configuration (MySQL 8 with local SQLite fallback for testing)
# Docker / Production MySQL:
DATABASE_URL="mysql+pymysql://automind_user:automind_pass@localhost:3307/automind_db"
# Local Isolated Testing SQLite:
# DATABASE_URL="sqlite:///./automind_test.db"

# JWT Authentication
JWT_SECRET="your-strong-jwt-secret-here-use-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & Local LLM Provider
LLM_PROVIDER="local" # Deterministic grounded reasoning & local model provider
LLM_MODEL_ID="qwen_lora_v4"
EMBEDDING_MODEL_ID="all-MiniLM-L6-v2"

# Vector Store
VECTOR_STORE_TYPE="local"
VECTOR_INDEX_PATH="./vector_index"

# CORS Configuration
FRONTEND_URL="http://localhost:5173"
# Comma-separated list of allowed origins for production:
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Real-time Web Grounding (Optional)
ENABLE_DUCKDUCKGO_SEARCH=True
DUCKDUCKGO_MAX_RESULTS=5
